NODE_ENV=development
PORT=5050
# Listen on all interfaces so this machine can host LAN clients (firewall opens 5050/5173).
HOST=0.0.0.0
SQL_SERVER=CHANGE_ME_SQL_SERVER
SQL_INSTANCE=
# Production client cutover default. Change only if the client database name differs.
SQL_DATABASE=Subscriptions
SQL_AUTH=windows
SQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server
SQL_ENCRYPT=true
# Lab / self-signed SQL TLS: set true on site. Prefer false when a proper cert is in place.
SQL_TRUST_CERT=true
# SQL_AUTH=sql
# SQL_USER=
# SQL_PASSWORD=
# Must be 32+ random chars; installer generates if still a placeholder.
JWT_SECRET=CHANGE_ME_64_HEX_CHARACTERS_MINIMUM
BACKUP_ENABLED=false
BACKUP_ALLOW_LIVE=false
SQL_BACKUP_DIR=D:\\SubscriptionsBackups
SERVE_WEB=false
LEGACY_MIRROR_ENABLED=false
