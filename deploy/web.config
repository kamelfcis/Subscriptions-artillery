<?xml version="1.0" encoding="utf-8"?>
<configuration>
 <system.webServer>
  <!-- TLS ends at IIS. Proxy every path, including /api/health and /api/ready, to the loopback Node process. Do not publish Node on a LAN address. -->
  <rewrite><rules>
   <rule name="Subscriptions Node HTTPS Reverse Proxy" stopProcessing="true">
    <match url="(.*)" />
    <action type="Rewrite" url="http://127.0.0.1:5050/{R:1}" />
   </rule>
  </rules></rewrite>
  <security><requestFiltering><requestLimits maxAllowedContentLength="12000000" /></requestFiltering></security>
 </system.webServer>
</configuration>
