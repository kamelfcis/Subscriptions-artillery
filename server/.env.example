NODE_ENV=development
PORT=5050
HOST=127.0.0.1
SQL_SERVER=DESKTOP-7Q8JPT0
SQL_INSTANCE=
# Dev/staging: Subscriptions_Staging. Client parallel install: Subscriptions2. Live legacy app: Subscriptions.
SQL_DATABASE=Subscriptions_Staging
# SQL_DATABASE=Subscriptions2
SQL_AUTH=windows
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
SQL_ENCRYPT=true
SQL_TRUST_CERT=false
# SQL_AUTH=sql
# SQL_USER=
# SQL_PASSWORD=
# Must be 32+ random chars; openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_HEX_CHARACTERS_MINIMUM
# Optional override for `npm run bootstrap-admin` (default is 12345678)
# BOOTSTRAP_PASSWORD=12345678
# Enable only after granting the SQL Server service account folder write access and permission to BACKUP DATABASE
BACKUP_ENABLED=false
# Required before the API will back up the live database name Subscriptions. Leave false.
BACKUP_ALLOW_LIVE=false
SQL_BACKUP_DIR=D:\\SubscriptionsBackups
# Staging keeps this false. Set true only to serve web/dist from Express on the same origin.
SERVE_WEB=false

# Do NOT enable without verifying legacy subscriptioninf count/MCount/active business meaning.
LEGACY_MIRROR_ENABLED=false
# LEGACY_MIRROR_COUNT=
# LEGACY_MIRROR_MCOUNT=
# LEGACY_MIRROR_ACTIVE=
